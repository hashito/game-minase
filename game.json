  "recipes": {
    "props": true,
    "textures": "assets/textures/",
    "ambience": {
      "beds": [
        {
          "name": "rain",
          "kind": "rain",
          "level": 0.35
        }
      ]
    }
  },
  "voice": true,
  "things": true,
  "controls": {
    "crouch": true,
    "flashlight": {
      "color": 14674175,
      "intensity": 18,
      "distance": 16,
      "angle": 0.7
    },
    "fov": 72,
    "far": 55,
    "gate": {
      "crouch": "L3"
    },
    "touch": [
      {
        "k": "KeyE",
        "label": "操作",
        "cls": "big"
      },
      {
        "k": "KeyF",
        "label": "ライト"
      }
    ],
    "gateText": "今は、まだ使えない。先に、いまの目的を進めよう。",
    "runButton": true
  },
  "portraits": {
    "ひなた": "assets/photos/face-hinata.webp",
    "黒木": "assets/photos/face-kuroki.webp",
    "浅井": "assets/photos/face-asai.webp"
  },
  "deaths": {
    "default": {
      "text": "つかまった。",
      "sub": "最後に作業を終えた場所から、やり直す。",
      "retry": "やり直す"
    },
    "chimera": {
      "text": "縫い合わされた何本もの腕に、水の中へ引きずりこまれた。",
      "sub": "標本を縫い合わせたあれは、瓶を持つ者を、水の中を通って追ってくる。後ろに来たら、止水弁に向いて［E］で回す。抜いた水が戻るまでに、先へ逃げる。台の上のロッカーに隠れてもよい。",
      "photo": "assets/photos/mon-close.webp",
      "retry": "やり直す"
    },
    "seal": {
      "text": "防水扉が、向こうから押し開けられた。",
      "sub": "防水扉を抜けたら、すぐに振り返って、扉に向いて［E］で閉める。",
      "photo": "assets/photos/mon-close.webp",
      "retry": "やり直す"
    },
    "flood": {
      "text": "排水口の水が、部屋を満たした。",
      "sub": "ひなたが逆止弁を押さえていられるのは、間違えるまで。集めた物（カルテ・新聞・排水日誌・台帳・名札）を思い出して、もう一度答える。",
      "photo": "assets/photos/mon-close.webp",
      "retry": "やり直す"
    },
    "lesson": {
      "text": "水の中から伸びた腕に、足首をつかまれた。",
      "sub": "あれに触れると、つかまる。止水弁の前の、乾いた所まで戻る。",
      "retry": "やり直す"
    }
  },
  "titleImage": "assets/photos/title.webp",
  "hud": {
    "quietFor": 60,
    "dimInDanger": true
  },
  "approach": {
    "vignette": true,
    "heartbeat": true,
    "shake": true,
    "dizzy": false,
    "presence": "wet",
    "catchImage": "assets/photos/mon-close.webp",
    "catchOn": [
      "chimera",
      "seal",
      "flood",
      "lesson"
    ]
  },
  "share": {
    "tags": [
      "水無瀬病院",
      "ホラーゲーム"
    ]
  },
  "thoughtVoices": "assets/voice/thoughts.json",
