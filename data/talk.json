{
  "opening": [
    {
      "who": "私",
      "text": "私は戸川湊、大学一年。幼なじみの篠原ひなたと、心霊動画を撮りに、山あいの廃病院へ来た。",
      "img": "assets/photos/op-hospital.webp",
      "id": "opening-1",
      "voice": "assets/voice/opening-1.mp3"
    },
    {
      "who": "私",
      "text": "水無瀬病院。二十七年前、台風の夜に地下が水につかって、そのまま閉まった病院だ。今夜も雨が降っている。",
      "img": "assets/photos/op-rain.webp",
      "id": "opening-2",
      "voice": "assets/voice/opening-2.mp3"
    },
    {
      "who": "私",
      "text": "玄関ホールで撮りはじめたとき、地元の先輩の黒木さんたちが入って来た。携帯を二人とも取り上げられた。",
      "img": "assets/photos/op-kuroki.webp",
      "id": "opening-3",
      "voice": "assets/voice/opening-3.mp3"
    },
    {
      "who": "私",
      "text": "黒木さんたちは外へ出て、正面の扉の取っ手に鎖を巻いた。裏口も窓も、板で打ちつけてある。",
      "img": "assets/photos/op-chain.webp",
      "id": "opening-4",
      "voice": "assets/voice/opening-4.mp3"
    },
    {
      "who": "黒木",
      "where": "鎖の扉の外",
      "text": "地下の標本室に、七番の瓶がある。それを持って来い。持って来るまで、鎖は外さん。",
      "img": "assets/photos/op-chain.webp",
      "id": "opening-5",
      "voice": "assets/voice/opening-5.mp3"
    },
    {
      "who": "私",
      "text": "出るには、地下の七番の瓶を持って来るしかない。まずは、ひなたと相談しよう。",
      "img": "assets/photos/op-chain.webp",
      "id": "opening-6",
      "voice": "assets/voice/opening-6.mp3"
    }
  ],
  "hina1": [
    {
      "who": "ひなた",
      "text": "湊、ごめん。私が撮りに行こうって言ったから。",
      "id": "hina1-1",
      "voice": "assets/voice/hina1-1.mp3"
    },
    {
      "who": "私",
      "text": "ひなたのせいじゃない。……黒木さん、本気だ。",
      "id": "hina1-2",
      "voice": "assets/voice/hina1-2.mp3"
    },
    {
      "who": "ひなた",
      "text": "無線機は取られなかった。撮影で使うつもりだった二台。離れても、これで話せる。",
      "id": "hina1-3",
      "voice": "assets/voice/hina1-3.mp3"
    },
    {
      "who": "ひなた",
      "text": "黒木さん、なんで「七番」なんだろう。……扉のところで、聞いてみて。",
      "id": "hina1-4",
      "voice": "assets/voice/hina1-4.mp3"
    }
  ],
  "front": [
    {
      "who": "私",
      "text": "黒木さん、開けてください。こんなの、ただの肝試しじゃないですか。",
      "id": "front-1",
      "voice": "assets/voice/front-1.mp3"
    },
    {
      "who": "黒木",
      "where": "鎖の扉の外",
      "text": "肝試しじゃねえよ。……去年、俺の弟の蓮が、ここの地下まで入った。",
      "img": "assets/photos/tk-kuroki-door.webp",
      "id": "front-2",
      "voice": "assets/voice/front-2.mp3"
    },
    {
      "who": "黒木",
      "where": "鎖の扉の外",
      "text": "出て来てから、あいつは一言もしゃべらねえ。紙に「7」って、そればっかり書いてる。",
      "id": "front-3",
      "voice": "assets/voice/front-3.mp3"
    },
    {
      "who": "私",
      "text": "鎖のすき間から、くしゃくしゃの紙が押しこまれた。紙いっぱいに、鉛筆の「7」。",
      "id": "front-4",
      "voice": "assets/voice/front-4.mp3"
    },
    {
      "who": "黒木",
      "where": "鎖の扉の外",
      "text": "俺は、下までは行けなかった。……蓮が何を見たのか知りたい。地下の標本室の、七番の瓶を持って来い。",
      "id": "front-5",
      "voice": "assets/voice/front-5.mp3"
    },
    {
      "who": "黒木",
      "where": "鎖の扉の外",
      "text": "持って来たら、鎖は外す。携帯も返す。……持って来なけりゃ、朝まで開けねえ。",
      "id": "front-6",
      "voice": "assets/voice/front-6.mp3"
    },
    {
      "who": "ひなた",
      "text": "湊。……受付に、鍵の箱があったよ。地下へ降りる階段の鍵、あるかもしれない。",
      "id": "front-7",
      "voice": "assets/voice/front-7.mp3"
    }
  ],
  "key_done": [
    {
      "who": "私",
      "text": "「階段 防火扉」の札のついた鍵。……これで、地下へ降りられる。",
      "id": "key_done-1",
      "voice": "assets/voice/key_done-1.mp3"
    },
    {
      "who": "ひなた",
      "text": "待って。七番って何の番号か分かんないまま行くの、こわい。カルテ庫を見てからにしよう。廊下の西の端。",
      "id": "key_done-2",
      "voice": "assets/voice/key_done-2.mp3"
    }
  ],
  "karte_done": [
    {
      "who": "ひなた",
      "text": "浅井庄一さん。……カルテに「七」の付箋。亡くなった人の体を、地下で調べたってこと？",
      "id": "karte_done-1",
      "voice": "assets/voice/karte_done-1.mp3"
    },
    {
      "who": "私",
      "text": "病理解剖。死んだ理由を確かめるために、体を調べる。……「臓器の保存」の、家族の同意が空欄だ。",
      "id": "karte_done-2",
      "voice": "assets/voice/karte_done-2.mp3"
    },
    {
      "who": "ひなた",
      "text": "七番の瓶って、もしかして。……ううん、行こう。階段は、廊下の東の防火扉の奥。",
      "id": "karte_done-3",
      "voice": "assets/voice/karte_done-3.mp3"
    }
  ],
  "down": [
    {
      "who": "私",
      "text": "階段は途中から崩れ落ちていた。エレベーターも止まっている。壁の点検口の鉄のはしごで、地下へ降りた。",
      "id": "down-1",
      "voice": "assets/voice/down-1.mp3"
    },
    {
      "who": "私",
      "text": "地下は、くるぶしまで水につかっていた。雨水が、壁のすき間から流れこんでいる。",
      "id": "down-2",
      "voice": "assets/voice/down-2.mp3"
    },
    {
      "who": "ひなた",
      "text": "いっ……！　ごめん、はしごの最後の段で、すべった。足首……ひねったかも。",
      "id": "down-3",
      "voice": "assets/voice/down-3.mp3"
    },
    {
      "who": "私",
      "text": "ひなたは立てるけれど、まともには歩けない。……水の中を、長い通路の奥までは無理だ。",
      "id": "down-4",
      "voice": "assets/voice/down-4.mp3"
    },
    {
      "who": "ひなた",
      "text": "ポンプ室って、案内図にあったよね。発電機が動けば、水が抜けるかも。そこまでなら行ける。",
      "id": "down-5",
      "voice": "assets/voice/down-5.mp3"
    }
  ],
  "gen_done": [
    {
      "who": "私",
      "text": "発電機がうなり、天井の非常灯が、ぽつぽつとついた。壁の水位計の針が、ゆっくり下がりはじめる。",
      "id": "gen_done-1",
      "voice": "assets/voice/gen_done-1.mp3"
    },
    {
      "who": "ひなた",
      "text": "私、ここに残る。ポンプを見てる。水が上がってきたら、無線で知らせるから。",
      "id": "gen_done-2",
      "voice": "assets/voice/gen_done-2.mp3"
    },
    {
      "who": "ひなた",
      "text": "だから湊、無線の周波数、合わせておこう。私のと同じところに。",
      "id": "gen_done-3",
      "voice": "assets/voice/gen_done-3.mp3"
    }
  ],
  "radio_done": [
    {
      "who": "ひなた",
      "where": "無線",
      "text": "よし、聞こえる。……湊、何かあったら、すぐ呼んで。ほんとに。",
      "id": "radio_done-1",
      "vfx": "phone",
      "voice": "assets/voice/radio_done-1.mp3"
    },
    {
      "who": "私",
      "text": "研究棟への通路は、地下の廊下の西の端。防水扉の向こうだ。",
      "id": "radio_done-2",
      "voice": "assets/voice/radio_done-2.mp3"
    }
  ],
  "bousui_done": [
    {
      "who": "私",
      "text": "防水扉の向こうは、配管の通路。真っ暗で、ずっと奥まで続いている。水の流れる音。",
      "id": "bousui_done-1",
      "voice": "assets/voice/bousui_done-1.mp3"
    },
    {
      "who": "ひなた",
      "where": "無線",
      "text": "湊、通路の壁に、非常灯のスイッチがあるはず。帰りに道が見えるように、つけていって。",
      "id": "bousui_done-2",
      "vfx": "phone",
      "voice": "assets/voice/bousui_done-2.mp3"
    }
  ],
  "gate": [
    {
      "who": "私",
      "text": "二枚目の防水扉の、窓の向こう。水が、窓の高さまで満ちている。……水の中に、何かいる。",
      "id": "gate-1",
      "voice": "assets/voice/gate-1.mp3"
    },
    {
      "who": "浅井",
      "where": "窓の向こうの水の中",
      "text": "……かえして……。",
      "id": "gate-2",
      "voice": "assets/voice/gate-2.mp3"
    },
    {
      "who": "私",
      "text": "人ではない。いくつもの体を、一つに縫い合わせたもの。腕は左右で長さも色も違い、肩にもう一つ、うなだれた頭。その手が、窓を叩いている。",
      "id": "gate-3",
      "voice": "assets/voice/gate-3.mp3"
    },
    {
      "who": "私",
      "text": "ひなた、扉の向こうが水でいっぱいだ。……何かいる。ポンプで、この先の水を抜けないか。",
      "id": "gate-4",
      "voice": "assets/voice/gate-4.mp3"
    },
    {
      "who": "ひなた",
      "where": "無線",
      "text": "やってみる。研究棟側のポンプ、二号に切りかえる。……今！",
      "id": "gate-5",
      "vfx": "phone",
      "voice": "assets/voice/gate-5.mp3"
    },
    {
      "who": "私",
      "text": "窓の向こうの水が、渦を巻いて引いていく。水が下がると、あれも一緒に沈んで、見えなくなった。",
      "id": "gate-6",
      "voice": "assets/voice/gate-6.mp3"
    },
    {
      "who": "私",
      "text": "……水から出てこない。水が引くと、あれは一緒に退いた。",
      "id": "gate-7",
      "voice": "assets/voice/gate-7.mp3"
    }
  ],
  "post_ok": [
    {
      "who": "私",
      "text": "止まった。乾いた床の手前で、あれが身をよじっている。……でも、床の溝から、水がにじみ戻ってくる。",
      "id": "post_ok-1",
      "voice": "assets/voice/post_ok-1.mp3"
    },
    {
      "who": "私",
      "text": "あれは、水のある所しか動けない。止水弁を閉めて床を乾かせば、そこから先へは来られない。",
      "id": "post_ok-2",
      "voice": "assets/voice/post_ok-2.mp3"
    }
  ],
  "post_done": [
    {
      "who": "私",
      "text": "水が戻った。……あれは水から跳ね起きて、一歩こっちへ来て――また水の中へ沈んでいった。",
      "id": "post_done-1",
      "voice": "assets/voice/post_done-1.mp3"
    },
    {
      "who": "ひなた",
      "where": "無線",
      "text": "湊！　大丈夫？　何があったの。",
      "id": "post_done-2",
      "vfx": "phone",
      "voice": "assets/voice/post_done-2.mp3"
    },
    {
      "who": "私",
      "text": "あれは、水のある所しか進めない。止水弁を回して水を抜けば、そこで止まる。でも、水はしばらくで戻ってくる。",
      "id": "post_done-3",
      "voice": "assets/voice/post_done-3.mp3"
    },
    {
      "who": "私",
      "text": "通路のロッカーは、一段高い台の上にある。中に入れば、足が水から上がる。……見失うかもしれない。",
      "id": "post_done-4",
      "voice": "assets/voice/post_done-4.mp3"
    }
  ],
  "hyohon": [
    {
      "who": "私",
      "text": "病理標本室。壁の棚に、ガラス瓶が何十本も並んでいる。黄色い液の中に、人の臓器。",
      "img": "assets/photos/in-hyohon.webp",
      "id": "hyohon-1",
      "voice": "assets/voice/hyohon-1.mp3"
    },
    {
      "who": "私",
      "text": "つんと鼻を刺すにおい。ホルマリン。標本を腐らせないための薬だ。床の槽にも、同じ液がたまっている。",
      "id": "hyohon-2",
      "voice": "assets/voice/hyohon-2.mp3"
    },
    {
      "who": "私",
      "text": "北の壁の、ガラス戸の戸棚。いちばん奥に、ラベルに「7」とだけ書いた瓶がある。",
      "id": "hyohon-3",
      "voice": "assets/voice/hyohon-3.mp3"
    },
    {
      "who": "ひなた",
      "where": "無線",
      "text": "湊、聞こえる？　……雨が強くなってる。水位計の針が、また上がりはじめた。急いで。",
      "id": "hyohon-4",
      "vfx": "phone",
      "voice": "assets/voice/hyohon-4.mp3"
    }
  ],
  "rise": [
    {
      "who": "私",
      "text": "瓶の首に、ひもで名札と小さな鍵が結んである。名札は「検査科　浅井早苗」。……新聞の、行方不明の技師の人だ。",
      "id": "rise-1",
      "voice": "assets/voice/rise-1.mp3"
    },
    {
      "who": "浅井",
      "where": "うしろの槽から",
      "text": "……かえして……それは、わたしの……。",
      "id": "rise-2",
      "voice": "assets/voice/rise-2.mp3"
    },
    {
      "who": "私",
      "text": "懐中電灯が、ばちっと消えた。非常灯の明かりの中で、槽の液が盛り上がる。",
      "id": "rise-3",
      "voice": "assets/voice/rise-3.mp3"
    },
    {
      "who": "私",
      "text": "立ち上がったのは、一人の人ではなかった。いくつもの体を縫い合わせたもの。割れた瓶のガラスと排水のホースが、体に食いこんでいる。いちばん上に、髪の長い女の人の顔。",
      "id": "rise-4",
      "voice": "assets/voice/rise-4.mp3"
    },
    {
      "who": "私",
      "text": "……逃げろ。止水弁を回しながら、防水扉まで。",
      "id": "rise-5",
      "voice": "assets/voice/rise-5.mp3"
    },
    {
      "who": "ひなた",
      "where": "無線",
      "text": "湊！　研究棟の排水が逆流して……通路に水が……ポンプが、と……ザザッ……",
      "id": "rise-6",
      "vfx": "phone",
      "voice": "assets/voice/rise-6.mp3"
    }
  ],
  "top": [
    {
      "who": "私",
      "text": "防水扉を抜けた。うしろの通路の水の中から、あれが来る。……扉を閉めないと！",
      "id": "top-1",
      "voice": "assets/voice/top-1.mp3"
    }
  ],
  "seal_done": [
    {
      "who": "私",
      "text": "扉を閉めて、ハンドルを回しきった。向こうから叩く音が、しだいに遠ざかる。",
      "id": "seal_done-1",
      "voice": "assets/voice/seal_done-1.mp3"
    },
    {
      "who": "私",
      "text": "……ひなた？　ひなた、聞こえるか。",
      "id": "seal_done-2",
      "voice": "assets/voice/seal_done-2.mp3"
    },
    {
      "who": "私",
      "text": "無線は雑音だけだ。地下の廊下の水が、また上がっている。……ポンプ室だ。",
      "id": "seal_done-3",
      "voice": "assets/voice/seal_done-3.mp3"
    }
  ],
  "rescue_in": [
    {
      "who": "ひなた",
      "text": "湊……！　ポンプが止まって、水が……。足が、動かなくて。",
      "id": "rescue_in-1",
      "voice": "assets/voice/rescue_in-1.mp3"
    },
    {
      "who": "私",
      "text": "ひなたは机の上に上がっている。水は、もう膝の上まで来ている。東の壁の制御盤で、ポンプを動かさないと。",
      "id": "rescue_in-2",
      "voice": "assets/voice/rescue_in-2.mp3"
    }
  ],
  "rescue_done": [
    {
      "who": "ひなた",
      "text": "……ありがとう。死ぬかと思った。",
      "id": "rescue_done-1",
      "voice": "assets/voice/rescue_done-1.mp3"
    },
    {
      "who": "私",
      "text": "瓶の首に、名札と小さな鍵がついていた。「検査科　浅井早苗」。新聞の、行方不明の技師の人だ。",
      "id": "rescue_done-2",
      "voice": "assets/voice/rescue_done-2.mp3"
    },
    {
      "who": "ひなた",
      "text": "鍵……病理事務室に、鍵のかかった棚があった。地下に降りて来たとき、廊下から見えたの。",
      "id": "rescue_done-3",
      "voice": "assets/voice/rescue_done-3.mp3"
    },
    {
      "who": "ひなた",
      "text": "あそこを開ければ、何か分かるかも。……肩、貸して。私も行く。",
      "id": "rescue_done-4",
      "voice": "assets/voice/rescue_done-4.mp3"
    }
  ],
  "ledger_done": [
    {
      "who": "私",
      "text": "台帳に、番号と、名前が戻った。七番は、浅井庄一さんの心臓。……早苗さんのお父さんだ。",
      "id": "ledger_done-1",
      "voice": "assets/voice/ledger_done-1.mp3"
    },
    {
      "who": "私",
      "text": "台帳のいちばん後ろに「合成標本　一号～六号」。材料の欄に、標本の番号がいくつも並んでいる。署名は、葛城。……あの、縫い合わされたものだ。",
      "id": "ledger_done-2",
      "voice": "assets/voice/ledger_done-2.mp3"
    },
    {
      "who": "私",
      "text": "棚の奥に、もう一つ鍵があった。札に「霊安室 搬出口」。……正面の扉を通らずに、外へ出られる。",
      "id": "ledger_done-3",
      "voice": "assets/voice/ledger_done-3.mp3"
    },
    {
      "who": "ひなた",
      "text": "湊……床の排水口。水が、噴き出してる！",
      "id": "ledger_done-4",
      "voice": "assets/voice/ledger_done-4.mp3"
    },
    {
      "who": "私",
      "text": "病理事務室の床の排水口から、黄色い水が湧いている。……排水管は、研究棟とつながっているんだ。",
      "id": "ledger_done-5",
      "voice": "assets/voice/ledger_done-5.mp3"
    },
    {
      "who": "ひなた",
      "text": "逆止弁、ここ！　私が押さえてる。湊、早く……あの人が何をしたいのか、分かれば……！",
      "id": "ledger_done-6",
      "voice": "assets/voice/ledger_done-6.mp3"
    }
  ],
  "hold_urge": [
    {
      "who": "ひなた",
      "text": "……っ、下から、押してくる……！　湊、机！　早く！",
      "id": "hold_urge-1",
      "voice": "assets/voice/hold_urge-1.mp3"
    },
    {
      "who": "ひなた",
      "text": "手が……弁の下から、指が出てくる……！",
      "id": "hold_urge-2",
      "voice": "assets/voice/hold_urge-2.mp3"
    },
