  "think": {
    "intro": "事務机に、集めた物を並べた。カルテ、新聞の切り抜き、排水日誌、台帳、名札。……あの人が何をしたいのか、一つずつ確かめる。",
    "questions": [
      {
        "q": "七番の瓶の心臓は、誰のものか。",
        "options": [
          {
            "id": "sanae",
            "label": "浅井早苗さん本人",
            "why": "台帳の七番は1996年の心臓。早苗さんがいなくなったのは1999年だ。"
          },
          {
            "id": "ren",
            "label": "黒木さんの弟の、蓮さん",
            "why": "蓮さんは生きている。台帳の七番は1996年だ。"
          },
          {
            "id": "father",
            "label": "浅井庄一さん（早苗さんの父）",
            "ok": true,
            "why": "台帳の七番は1996年の心臓、浅井庄一さん。カルテには「七」の付箋と、空欄の家族の同意。名札は、娘の早苗さん。"
          }
        ]
      },
      {
        "q": "早苗さんは、台風の夜、なぜ研究棟の地下へ降りたのか。",
        "options": [
          {
            "id": "duty",
            "label": "当直で、水を抜く仕事があったから",
            "why": "水を見ていたのはポンプ室だ。早苗さんがいたのは標本室。名札は、七番の瓶に結んであった。"
          },
          {
            "id": "father",
            "label": "父の心臓を、取り戻すため",
            "ok": true,
            "why": "名札と台帳の鍵は、七番の瓶に結んであった。父の瓶と、名前の分かる鍵を、一緒に持ち出そうとした。"
          },
          {
            "id": "sell",
            "label": "標本を盗んで、売るため",
            "why": "早苗さんが持っていたのは、七番の瓶と、名前の分かる台帳の鍵だけだ。"
          }
        ]
      },
      {
        "q": "研究棟側の防水扉を閉めたのは、誰か。",
        "options": [
          {
            "id": "sanae",
            "label": "早苗さん自身",
            "why": "防水扉のハンドルは、本館側にある。中にいる人には閉められない。排水日誌に、誰の指示と書いてあった？"
          },
          {
            "id": "katsuragi",
            "label": "副院長の葛城医師",
            "ok": true,
            "why": "排水日誌：23時40分、防水扉を閉鎖（葛城副院長の指示）。5分後の「研究棟に浅井技師の姿」の一行は消してあった。新聞では「病院を出た」と話した。"
          },
          {
            "id": "kuroki",
            "label": "黒木さんたち",
            "why": "黒木さんたちが来たのは今夜だ。扉が閉められたのは、1999年の台風の夜。"
          }
        ]
      },
      {
        "q": "水の中のあれは、何を探しているのか。",
        "options": [
          {
            "id": "revenge",
            "label": "瓶を持ち出した者に、仕返しがしたい",
            "why": "あれは瓶を持つ者だけを追った。言ったのは「かえして」。仕返しではない。"
          },
          {
            "id": "out",
            "label": "病院から外へ出たい",
            "why": "外へ出たいなら、防水扉が開いていたとき、出られた。あれは、瓶の近くから離れない。"
          },
          {
            "id": "father",
            "label": "父の心臓を、自分の手に取り戻したい",
            "ok": true,
            "why": "あれは七番の瓶を持つ者だけを追い、「かえして」「それは、わたしの」と言った。早苗さんが取り戻しに来た、父の心臓だ。"
          }
        ]
      }
    ]
